server {
  listen ${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Directory redirects (e.g. /zh-CN -> /zh-CN/) must stay relative: the
  # container listens on an internal port behind the proxy.
  absolute_redirect off;
  port_in_redirect off;

  # Long-lived caching for static assets; CSS/JS carry a ?v= version query.
  location ~* \.(?:png|jpg|jpeg|webp|svg|ico|woff2?)$ {
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
    access_log off;
    try_files $uri =404;
  }

  location ~* \.(?:css|js)$ {
    expires 7d;
    add_header Cache-Control "public, max-age=604800";
    access_log off;
    try_files $uri =404;
  }

  # HTML must always revalidate so deploys show up immediately.
  location ~* \.html$ {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }

  location = /healthz {
    add_header Content-Type text/plain;
    return 200 'ok';
  }

  location = /chat {
    return 301 /chat/;
  }

  location / {
    try_files $uri $uri/ =404;
  }
}
